# TDI500 SlimWonen Monitor - Environment Variables
# Copy to .env and fill in your values

# HUPIE Datastekker (TDI500 3.1)
VITE_HUPIE_ENDPOINT=https://hupie.2025.2.2.2/sparql
VITE_HUPIE_TOKEN=your_token_here

# OpenWeatherMap
VITE_OWM_API_KEY=your_key_here
VITE_OWM_LAT=52.0907
VITE_OWM_LON=5.1214

# ENTSO-E (energietarieven)
VITE_ENTSOE_TOKEN=your_token_here

# RIVM Luchtkwaliteit
VITE_RIVM_STATION=NL49017  # Rotterdam

# MQTT Broker (voor lokale sensoren)
VITE_MQTT_BROKER=ws://localhost:9001
VITE_MQTT_USER=
VITE_MQTT_PASS=

# AirTeq AirCheq sensor
VITE_AIRTEQ_SENSOR_ID=08:3A:F2:95:8C:E0

# Mode: 'test' or 'live'
VITE_MODE=test
